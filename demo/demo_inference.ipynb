# Demo: Predict Elastic Properties from RVE Image + Constituent Properties

This notebook demonstrates how to load the trained fusion model and predict
the 9 homogenized elastic constants of a unidirectional composite.
import numpy as np
import pandas as pd
import pickle
import tensorflow as tf
from tensorflow import keras
import sys
sys.path.append("..")
from models.physics_loss import physics_consistency_loss, mse_only, physics_penalty_only

TARGET_COLS = ["E11", "E22", "E33", "G12", "G13", "G23", "v12", "v13", "v23"]
# Load model and scalers (update paths to your saved files)
MODEL_PATH = "../output/fusion_model.keras"
SCALER_TAB_PATH = "../output/scaler_tab.pkl"
SCALER_OUT_PATH = "../output/scaler_output.pkl"

custom_objects = {
    "physics_consistency_loss": physics_consistency_loss,
    "mse_only": mse_only,
    "physics_penalty_only": physics_penalty_only,
}

model = keras.models.load_model(MODEL_PATH, custom_objects=custom_objects)
with open(SCALER_TAB_PATH, "rb") as f:
    sc_tab = pickle.load(f)
with open(SCALER_OUT_PATH, "rb") as f:
    sc_out = pickle.load(f)

print(f"Model loaded: {model.count_params():,} parameters")
# Load sample constituent properties
props = pd.read_csv("sample_properties.csv")
print("Input constituent properties:")
display(props)

# Scale
X_tab = sc_tab.transform(props.values).astype(np.float32)

# Create a dummy 384x384 image (replace with real RVE image)
# In practice, load your binary RVE cross-section here
X_img = np.zeros((len(props), 384, 384, 1), dtype=np.float32)
# Example: X_img = load_and_preprocess_rve_image("my_rve.png")

# Predict
y_pred_sc = model.predict(
    {"image_input": X_img, "tabular_input": X_tab}, verbose=0
)
y_pred = sc_out.inverse_transform(y_pred_sc)

# Display results
results = pd.DataFrame(y_pred, columns=TARGET_COLS)
print("\nPredicted elastic constants:")
display(results.round(4))
## Notes
- Replace the dummy image with a real 384×384 binary RVE cross-section.
- The model expects images normalized to [0,1] and centered by the training mean.
- Constituent properties must follow the order: Em, νm, Ef1, Ef2, Gf12, Gf23, νf12, νf23.
